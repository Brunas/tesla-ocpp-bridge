{
  "name": "tesla-ocpp-bridge",
  "image": "mcr.microsoft.com/devcontainers/python:3.14-trixie",
  "postCreateCommand": "pip install --user -r requirements-dev.txt",
  "forwardPorts": [8081, 9000],
  "portsAttributes": {
    "8081": { "label": "fake Wall Connector" },
    "9000": { "label": "fake OCPP CSMS" }
  },
  "containerEnv": {
    "STATE_FILE": "${containerWorkspaceFolder}/.data/state.json",
    "OPTIONS_FILE": "/nonexistent"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
