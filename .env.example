# Configuration for running the bridge outside Home Assistant:
# docker compose, the VS Code "Bridge -> CircleLink + real TWC" launch config,
# or a shell (set -a; . ./.env; set +a).
#
#   cp .env.example .env    # .env is git-ignored: keep your real values there
#
# On Home Assistant, ignore this file and use the app's Configuration tab.
# Names are the app options in upper case. Empty values use the defaults.
# Use whole-line comments only: some .env readers keep a trailing "# ..."
# as part of the value.

# OCPP backend: server URL without the charger ID, and the charger ID from the
# CircleLink app. Never commit the real ID.
OCPP_URL=wss://ocpp.circlelink.app
CHARGE_POINT_ID=
# Only if the backend gave you a password (HTTP Basic auth).
OCPP_PASSWORD=

# Wall Connector IP or hostname on your LAN (give it a DHCP reservation).
TWC_HOST=

# Required: exactly the station name you gave the charger in CircleLink.
# It is sent as the idTag of every session.
ID_TAG=TESLA
# Seconds between meter readings during a session (0 = off).
METER_VALUE_INTERVAL=60
# Seconds between Wall Connector polls.
POLL_INTERVAL=5
# debug | info | warning | error (debug prints raw OCPP frames)
LOG_LEVEL=info
# false only if the backend has a broken certificate.
VERIFY_TLS=true

# Container time zone, for log timestamps (docker compose only).
TZ=Europe/Vilnius
